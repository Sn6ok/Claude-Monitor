<?xml version="1.0" encoding="utf-8"?>
<!--
    Політика мережевої безпеки.

    Тут cleartext дозволено на рівні платформи, але це НЕ означає, що
    застосунок його використовує будь-де. Справжня перевірка живе в коді:
    `RelayEndpoint.validate()` приймає `ws://` ЛИШЕ для приватних адрес
    RFC 1918 і локального хоста, а для всього іншого вимагає `wss://`.

    Чому перевірка в коді, а не тут: цей файл оперує іменами доменів
    і не розуміє масок підмереж, тож описати «усі приватні адреси»
    засобами XML неможливо — довелося б перелічувати кожен IP окремо.

    Чому виняток для локальної мережі взагалі існує:

      * у домашній мережі немає інфраструктури для валідного сертифіката,
        а самопідписаний Android не прийме без встановлення власного CA
        на пристрій — це складніше й ризикованіше для користувача;
      * такий трафік не залишає локальної мережі;
      * головне: вміст подій зашифрований наскрізно (AES-256-GCM)
        НЕЗАЛЕЖНО від транспорту. Навіть у цьому режимі перехоплення
        трафіку не розкриває ані подій, ані назв задач, ані шляхів.

    Тобто послаблюється лише транспортний шар і лише в межах домашньої
    мережі; прикладне шифрування працює завжди.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!--
                Лише системні центри сертифікації. Сертифікати, додані
                користувачем, свідомо НЕ приймаються: інакше будь-хто,
                хто вмовив користувача встановити свій CA, зміг би
                перехопити з'єднання.
            -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
